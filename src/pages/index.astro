---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cleve's Homepage — Est. 1996">
  <table width="100%" cellpadding="0" cellspacing="6">
    <tr style="vertical-align: top;">
      <!-- ===== Main content ===== -->
      <td style="width: 65%" class="bg-[#00003a] border-inset p-4">
        <h2
          class="font-comic text-lg pb-1 mt-0 mb-2 border-b border-dashed border-cyan-800"
          style="color:#00ffff"
        >
          🌐 Welcome to My Homepage!
        </h2>
        <p class="text-gray-300 text-sm leading-relaxed mb-3">
          Hey there, fellow Netizen! I'm{" "}
          <strong class="text-yellow-400">Cleve</strong>, a full-stack developer
          with a passion for building things on the World Wide Web. Welcome to
          my little corner of the internet!
        </p>
        <p class="text-gray-300 text-sm leading-relaxed mb-3">
          I specialise in building modern web applications — from pixel-perfect
          frontends to rock-solid backends. Got a project in mind? You've come
          to the right place.
        </p>

        <!-- Under construction -->
        <div class="bg-construction border-4 border-red-600 p-3 my-4 text-center font-sans font-bold">
          🚧 &nbsp;
          <span
            class="animate-blink text-white text-sm"
            style="text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000"
          >
            !! SITE UNDER CONSTRUCTION !!
          </span>
          &nbsp; 🚧
          <br />
          <span
            class="text-white font-normal text-xs"
            style="text-shadow: 1px 1px 0 #000, -1px -1px 0 #000"
          >
            New projects added regularly!
          </span>
        </div>

        <!-- 90s AI disclaimer -->
        <div class="win95-outer bg-[#000044] p-2 my-2 flex items-start gap-2 font-sans text-xs">
          <span class="text-2xl leading-none shrink-0">🤖</span>
          <div>
            <span class="text-yellow-400 font-bold">100% HUMAN-MADE™</span>
            <span class="text-gray-300">
              &nbsp;— No so-called "Artificial Intelligence" was consulted,
              prompted, or let anywhere near this website. Every character was
              typed by an actual human person using{" "}
              <strong class="text-white">Notepad.exe</strong>. If you are from
              the future where robots write websites... we are very sorry.
            </span>
          </div>
        </div>

        <h2
          class="font-comic text-lg pb-1 mt-5 mb-3 border-b border-dashed border-cyan-800"
          style="color:#00ffff"
        >
          ⚡ Featured Projects
        </h2>

        <!-- Gvelte -->
        <div class="bg-[#000044] win95-outer p-3 mb-3">
          <div class="flex items-center justify-between mb-1">
            <h3 class="font-comic text-base m-0 text-yellow-400">🏗️ Gvelte</h3>
            <span class="font-mono text-xs text-green-400 border border-green-800 px-1">LIVE</span>
          </div>
          <p class="text-gray-300 text-xs leading-relaxed mb-2">
            One command — <code class="text-green-400 bg-black px-1">gvelte create myapp</code> — and you get a full-stack project: SvelteKit 5 frontend with Svelte runes, and a compiled Go backend. Typed API client generated for you. No glue code. No boilerplate.
          </p>
          <p class="text-xs mb-2">
            <span class="text-green-400 font-sans font-bold">Stack:</span>
            <span class="text-gray-400 font-mono"> SvelteKit · Go · Bash</span>
          </p>
          <a href="https://www.21psychos.com/blog/gvelte-tease" target="_blank" rel="noopener noreferrer" class="retro-btn">🌐 Demo</a>
        </div>

        <!-- Bidstream -->
        <div class="bg-[#000044] win95-outer p-3 mb-3">
          <div class="flex items-center justify-between mb-1">
            <h3 class="font-comic text-base m-0 text-yellow-400">🔨 Bidstream</h3>
            <span class="font-mono text-xs text-green-400 border border-green-800 px-1">LIVE</span>
          </div>
          <p class="text-gray-300 text-xs leading-relaxed mb-2">
            The live auction floor your brand needs. You bring the stock — we bring the platform, the auctioneer, and the audience. Move 100+ units in a 60-minute show.
          </p>
          <p class="text-xs mb-2">
            <span class="text-green-400 font-sans font-bold">Stack:</span>
            <span class="text-gray-400 font-mono"> Next.js · Supabase · LiveKit · Stitch.io</span>
          </p>
          <a href="https://www.bidstream.online/" target="_blank" rel="noopener noreferrer" class="retro-btn">🌐 Demo</a>
        </div>

        <a href="/projects" class="retro-btn text-sm">📁 All Projects →</a>
      </td>

      <td style="width: 35%" valign="top">
        <!-- About blurb -->
        <div class="bg-[#00003a] win95-outer p-3 mb-2">
          <h3 class="font-comic text-sm text-yellow-400 mb-2">
            👤 About Cleve
          </h3>
          <p class="text-gray-300 text-xs leading-relaxed mb-2">
            Full-stack dev, 5+ years experience. I love clean code, good coffee,
            and pages that load in under 3 seconds.
          </p>
          <a href="/about" class="text-xs" style="color:#00ffff">
            Read More About Me »
          </a>
        </div>

        <div
          class="win95-outer mb-1 overflow-hidden cursor-pointer"
          data-ad-error="RUNTIME ERROR 0x0000DIAL: Your 56k modem is overheating. Please allow 45 minutes for the line to cool down. Telkom will continue charging R2.80/min during this waiting period. This is normal. This is fine."
        >
          <div class="bg-[#003399] text-white py-0.5 px-2 text-[9px] font-sans font-bold flex justify-between items-center">
            <span>★ ADVERTISEMENT ★</span>
            <span>✕</span>
          </div>
          <div
            class="p-2 text-center"
            style="background:linear-gradient(to bottom,#0055cc,#002299)"
          >
            <p class="font-comic text-yellow-400 text-xs font-bold animate-blink">
              📞 TELKOM INTERNET!
            </p>
            <p class="text-white text-[10px] font-sans">56kbps DIAL-UP!!</p>
            <p class="text-cyan-300 text-[10px] font-sans">Only R299/month!*</p>
            <p class="text-[8px] text-gray-400 font-sans">
              *excl. per-min phone charges
            </p>
            <span class="retro-btn text-[10px] mt-1 inline-block">
              CONNECT NOW!!
            </span>
          </div>
        </div>

        <div
          class="win95-outer mb-1 overflow-hidden cursor-pointer"
          data-ad-error="SPICY ERROR 0xPERIPERI: This ad is EXTRA HOT!! Your CPU cannot handle peri-peri level heat. Fan failure is imminent. Please turn off your computer and go eat some chicken. Have you tried our Lemon &amp; Herb flavour instead?"
        >
          <div class="bg-red-900 text-white py-0.5 px-2 text-[9px] font-sans font-bold flex justify-between items-center">
            <span>★ ADVERTISEMENT ★</span>
            <span>✕</span>
          </div>
          <div
            class="p-2 text-center"
            style="background:linear-gradient(to bottom,#cc2200,#880000)"
          >
            <p class="font-comic text-yellow-400 text-xs font-bold">
              🍗 NANDO'S
            </p>
            <p class="text-white text-[10px] font-sans">
              Flame-grilled websites!!
            </p>
            <p class="text-orange-300 text-[10px] font-sans animate-blink">
              🌶️ PERI-PERI HOT!!
            </p>
            <p class="text-[8px] text-gray-300 font-sans">
              Now in Lemon &amp; Herb flavour
            </p>
            <span class="retro-btn text-[10px] mt-1 inline-block">
              ORDER NOW!!
            </span>
          </div>
        </div>

        <div
          class="win95-outer mb-1 overflow-hidden cursor-pointer"
          data-ad-error="DID YOU KNOW? Clicking on this ad was completely pointless. Fun fact: This error message cost Telkom 3c to deliver to your screen. Chappies (Pty) Ltd accepts no liability for wasted bandwidth or disappointment."
        >
          <div class="bg-purple-900 text-white py-0.5 px-2 text-[9px] font-sans font-bold flex justify-between items-center">
            <span>★ ADVERTISEMENT ★</span>
            <span>✕</span>
          </div>
          <div
            class="p-2 text-center"
            style="background:linear-gradient(to bottom,#6600aa,#440077)"
          >
            <p class="font-comic text-yellow-400 text-xs font-bold">
              💜 CHAPPIES
            </p>
            <p class="text-white text-[10px] font-sans font-bold">
              DID YOU KNOW??
            </p>
            <p class="text-yellow-300 text-[10px] font-sans italic">
              "The internet was invented in 1991!!"
            </p>
            <p class="text-[8px] text-gray-300 font-sans">
              Only 20c at all tuck shops!!
            </p>
            <span class="retro-btn text-[10px] mt-1 inline-block">
              CHEW NOW!!
            </span>
          </div>
        </div>

        <div
          class="win95-outer mb-1 overflow-hidden cursor-pointer"
          data-ad-error="PRICE ERROR 0xOUTOFSTOCK: The item you clicked is now OUT OF STOCK. It was the last one. Someone from Pretoria bought it 3 minutes ago. LOWEST PRICES GUARANTEED on items we actually have in store."
        >
          <div class="bg-red-700 text-white py-0.5 px-2 text-[9px] font-sans font-bold flex justify-between items-center">
            <span>★ ADVERTISEMENT ★</span>
            <span>✕</span>
          </div>
          <div
            class="p-2 text-center"
            style="background:linear-gradient(to bottom,#cc0000,#880000)"
          >
            <p class="font-comic text-white text-xs font-bold">
              🛒 GAME STORES
            </p>
            <p class="text-yellow-400 text-[10px] font-sans font-bold animate-blink">
              LOWEST PRICES!!
            </p>
            <p class="text-white text-[10px] font-sans">Pentium 133MHz PC</p>
            <p class="text-yellow-400 text-sm font-bold font-sans">R4,999!!</p>
            <span class="retro-btn text-[10px] mt-1 inline-block">
              COME ON IN!!
            </span>
          </div>
        </div>

        <div
          class="win95-outer mb-2 overflow-hidden cursor-pointer"
          data-ad-error="DUNKING EXCEPTION 0xNO_TEA: You forgot to dunk. It is a criminal offence in South Africa to click on rusk advertisements without a hot cup of Rooibos tea. The Tea Police have been notified. Please braai responsibly."
        >
          <div
            class="text-white py-0.5 px-2 text-[9px] font-sans font-bold flex justify-between items-center"
            style="background:#5a3010"
          >
            <span>★ ADVERTISEMENT ★</span>
            <span>✕</span>
          </div>
          <div
            class="p-2 text-center"
            style="background:linear-gradient(to bottom,#c8956c,#7a4520)"
          >
            <p class="font-comic text-white text-xs font-bold">🍪 OUMA RUSKS</p>
            <p class="text-yellow-100 text-[10px] font-sans">
              Perfect for slow dial-up!!
            </p>
            <p class="text-white text-[10px] font-sans italic">
              "Dunk &amp; wait for pages to load!"
            </p>
            <p class="text-[8px] text-yellow-100 font-sans">
              New Buttermilk flavour!!
            </p>
            <span class="retro-btn text-[10px] mt-1 inline-block">
              DUNK NOW!!
            </span>
          </div>
        </div>

        <div class="bg-[#00003a] win95-outer p-3 mb-2">
          <h3 class="font-comic text-sm text-yellow-400 mb-2">
            🔧 Quick Skills
          </h3>
          <ul class="text-xs text-gray-300 space-y-1 list-none p-0 m-0">
            <li>⚛️ React / Next.js / Svelte</li>
            <li>⚡ Node.js / Express / Go</li>
            <li>🗄️ Supabase / MariaDB / SQLite</li>
            <li>🛠️ Docker / Vercel / Railway</li>
            <li>🎨 Figma / PenPot</li>
          </ul>
          <a href="/about" class="text-xs block mt-2" style="color:#00ffff">
            Full Skills List »
          </a>
        </div>

        <div class="bg-[#00003a] win95-outer p-3 text-center text-xs text-gray-400 leading-relaxed">
          🖥️ Best viewed in
          <br />
          <span class="text-white font-bold">Netscape Navigator 4.0</span>
          <br />
          at <span class="text-white">800×600</span> resolution
          <br />
          with <span class="text-white">256 colors</span>
        </div>
      </td>
    </tr>
  </table>

  <div
    id="ad-error-overlay"
    class="hidden fixed inset-0 z-200 items-center justify-center p-4"
    style="background:rgba(0,0,0,0.65)"
  >
    <div class="bg-[#c0c0c0] win95-raised w-96 max-w-full">
      <!-- Title bar -->
      <div
        class="flex items-center justify-between px-2 py-1 text-white text-xs font-bold font-sans select-none"
        style="background:linear-gradient(to right,#000080,#1084d0)"
      >
        <span>💥 Fatal Error — Cleve's Homepage</span>
        <button
          id="ad-err-x"
          class="bg-[#c0c0c0] text-black win95-raised px-1.5 py-0.5 text-xs font-bold cursor-pointer"
        >
          ✕
        </button>
      </div>

      <!-- Body -->
      <div class="p-5 flex gap-4 items-start">
        <span class="text-5xl leading-none shrink-0 select-none">💀</span>
        <div class="font-sans text-sm text-black leading-snug">
          <p class="font-bold mb-2 text-red-700">AN ERROR HAS OCCURRED</p>
          <p id="ad-error-msg" class="mb-3 text-black text-xs leading-relaxed">
            ...
          </p>
          <p class="font-mono text-[10px] text-[#555]">
            Error Code: 0xSAFRICA_1996
            <br />
            This program has performed an illegal operation
            <br />
            and will be shut down.
          </p>
        </div>
      </div>

      <!-- Buttons -->
      <div class="pb-4 flex justify-center gap-3">
        <button id="ad-err-ok" class="retro-btn min-w-17.5 text-center">
          OK
        </button>
        <button id="ad-err-ignore" class="retro-btn min-w-17.5 text-center">
          Ignore
        </button>
        <button id="ad-err-cancel" class="retro-btn min-w-17.5 text-center">
          Cancel
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const overlay = document.getElementById("ad-error-overlay");
  const msgEl = document.getElementById("ad-error-msg");

  // Open modal on any ad click
  document.querySelectorAll("[data-ad-error]").forEach((el) => {
    el.addEventListener("click", () => {
      if (msgEl) msgEl.textContent = el.getAttribute("data-ad-error") ?? "";
      overlay?.classList.remove("hidden");
    });
  });

  // All three buttons dismiss the modal
  ["ad-err-x", "ad-err-ok", "ad-err-ignore", "ad-err-cancel"].forEach((id) => {
    document.getElementById(id)?.addEventListener("click", () => {
      overlay?.classList.add("hidden");
    });
  });
</script>
